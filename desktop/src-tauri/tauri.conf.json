{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatIsNotHelper",
  "version": "1.0.0",
  "identifier": "com.fgeeha.cat-is-not-helper.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "cat",
        "title": "Cat Is Not Helper",
        "url": "cat.html",
        "width": 260,
        "height": 230,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": false
      },
      {
        "label": "panel",
        "title": "Котик",
        "url": "panel.html",
        "width": 820,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "Cat Is Not Helper",
      "showMenuOnLeftClick": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NTE1MTBGRjc4RjhFOTMKUldTVGpvLzNEMUZSeGZRTEYxbTBvbDFJellnUE8rbGswdnJYTkRuREtldWRDNlgzbWQwUzdqaXIK",
      "endpoints": [
        "https://github.com/Fgeeha/cat-is-not-helper/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "rpm",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Котик, который тапает вместе с тобой",
    "longDescription": "Котик сидит поверх всех окон, тапает лапками в такт нажатиям клавиш, ведёт статистику и держит скриншоты. Он не помогает. Он тапает.",
    "publisher": "Fgeeha",
    "copyright": "Котик не помогает. Котик тапает.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "rpm": {
        "release": "1",
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libXtst",
          "libXi"
        ]
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libxtst6",
          "libxi6"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
